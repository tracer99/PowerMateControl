#include "resource.h"
#include "version.h"
#include <windows.h>
#include <winver.h>

IDI_ICON_CONNECTED    ICON "../res/connected.ico"
IDI_ICON_DISCONNECTED ICON "../res/disconnected.ico"

IDB_LOGO RCDATA "../res/logo.png"

IDD_ABOUT DIALOGEX 0, 0, 260, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PowerMateControl"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_LOGO, "Static", SS_BITMAP | SS_CENTERIMAGE | SS_REALSIZECONTROL, 80, 8, 100, 64
    LTEXT           "PowerMateControl", -1, 10, 78, 240, 12, SS_CENTER
    LTEXT           "", IDC_ABOUT_VERSION, 10, 92, 240, 12, SS_CENTER
    LTEXT           "", IDC_ABOUT_MAINTAINER, 10, 106, 240, 12, SS_CENTER
    PUSHBUTTON      "GitHub", IDC_ABOUT_GITHUB, 12, 126, 55, 14
    PUSHBUTTON      "Report issue", IDC_ABOUT_ISSUES, 72, 126, 70, 14
    PUSHBUTTON      "Tip on Ko-fi", IDC_ABOUT_KOFI, 147, 126, 70, 14
    DEFPUSHBUTTON   "OK", IDOK, 105, 152, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     PMC_VERSION_COMMA
PRODUCTVERSION  PMC_VERSION_COMMA
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PowerMateControl"
            VALUE "FileDescription",  "Griffin PowerMate USB tray control"
            VALUE "FileVersion",      PMC_VERSION_STRING
            VALUE "InternalName",     "PowerMateControl"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "PowerMateControl.exe"
            VALUE "ProductName",      "PowerMateControl"
            VALUE "ProductVersion",   PMC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
